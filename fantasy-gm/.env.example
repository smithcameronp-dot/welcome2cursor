# Create a key at https://console.x.ai and copy this file to .env.local.
XAI_API_KEY=

# Optional. Defaults to grok-4.6. xAI retires model slugs periodically, so set
# this if the app reports an unrecognized model.
# GROK_MODEL=grok-4.6

# Optional. Only needed to point at a proxy or gateway instead of xAI directly.
# XAI_BASE_URL=https://api.x.ai/v1
